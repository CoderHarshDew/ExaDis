/* ---------- Global Styles ---------- */
QWidget {
    background-color: #2b2b2b;
    color: #f0f0f0;
    font-family: "Segoe UI", sans-serif;
    font-size: 12pt;
}

/* ---------- Labels ---------- */
QLabel {
    color: #f0f0f0;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #3c3f41;
    border: 1px solid #5a5a5a;
    border-radius: 6px;
    padding: 6px 12px;
    color: #f0f0f0;
}
QPushButton:hover {
    background-color: #505354;
    border-color: #f0f0f0;
    border: 1px solid #0078d7;
}
QPushButton:pressed {
    background-color: #2d2f30;
    border: 1px solid #0078d7;
}

/* ---------- Text Inputs ---------- */
QLineEdit, QTextEdit, QSpinBox, QComboBox {
    background-color: #3c3f41;
    border: 1px solid #5a5a5a;
    border-radius: 4px;
    padding: 4px;
    color: #f0f0f0;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
}

QLineEdit:hover, QTextEdit:hover, QSpinBox:hover, QComboBox:hover {
    background-color: #3c3f41;
    border: 1px solid #0078d7;
    border-radius: 4px;
    padding: 4px;
    color: #f0f0f0;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
}

/* ---------- Scroll Area ---------- */
QScrollArea {
    background-color: #2b2b2b;
    border: none;
}

/* ---------- Tabs ---------- */
QTabWidget::pane {
    border: 1px solid #5a5a5a;
    background-color: #2b2b2b;
}

/* Expand tabs equally */
QTabBar {
    qproperty-expanding: 1;
}

QTabBar::tab {
    background-color: #3c3f41;
    color: #f0f0f0;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    min-height: 32px;
    text-align: center;   /* Center text inside tabs */
}

QTabBar::tab:selected {
    background-color: #505354;
    border-bottom: 2px solid #0078d7;
}

QTabBar::tab:hover {
    background-color: #404344;
}

/* ---------- Checkboxes ---------- */
QCheckBox {
    spacing: 6px;
    color: #f0f0f0;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

/* Unchecked box */
QCheckBox::indicator:unchecked {
    border: 1px solid #888;
    border-radius: 3px;
    background: #3c3f41;
}

/* Checked box with checkmark */
QCheckBox::indicator:checked {
    border: 1px solid #0078d7;
    border-radius: 3px;
    background: #0078d7;
    image: url(assets/images/check_light.png); /* Replace with your custom check image */
}
